{
  "name": "@alibaba-group/open-code-review-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension for open-code-review: OCR reviews and delegation-mode selection from Pi",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/open-code-review.git",
    "directory": "plugins/open-code-review/pi"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "open-code-review"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:build": "node --test scripts/*.test.mjs",
    "build": "node scripts/build-package.mjs",
    "release": "npm run build && npm publish ./dist/package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  }
}
