    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.15",
    "postcss-loader": "^7.3.3",
    "serve": "^14.2.6",
    "size-limit": "^13.0.1",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
