    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "three": "^0.185.0"
  },
  "overrides": {
    "fast-uri": "^3.1.2"
  },
  "size-limit": [
    {
      "path": "dist/*.bundle.js",
      "limit": "150 kB"
    }
  ],
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.23.5",
    "@babel/preset-typescript": "^7.23.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^13.0.1",
